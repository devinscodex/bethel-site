{{/* One page per chapter from assets/bible/web/*.json (public-domain WEB; see tools/bible_build.py).
     Params: book, bslug, chapter, nch, verses, prev, next (each "slug/chapter" path or empty). */}}
{{ $books := (resources.Get "bible/web/books.json" | transform.Unmarshal) }}
{{ range $bi, $b := $books }}
  {{ $data := (resources.Get (printf "bible/web/%s.json" $b.s) | transform.Unmarshal) }}
  {{ range $c := seq $b.ch }}
    {{ $prev := "" }}{{ $next := "" }}
    {{ if gt $c 1 }}{{ $prev = printf "%s/%d" $b.s (sub $c 1) }}
    {{ else if gt $bi 0 }}{{ $p := index $books (sub $bi 1) }}{{ $prev = printf "%s/%d" $p.s $p.ch }}{{ end }}
    {{ if lt $c $b.ch }}{{ $next = printf "%s/%d" $b.s (add $c 1) }}
    {{ else if lt (add $bi 1) (len $books) }}{{ $n := index $books (add $bi 1) }}{{ $next = printf "%s/1" $n.s }}{{ end }}
    {{ $params := dict "book" $b.n "bslug" $b.s "chapter" $c "nch" $b.ch "verses" (index $data.c (sub $c 1)) "prev" $prev "next" $next }}
    {{ $.AddPage (dict "path" (printf "%s/%d" $b.s $c) "title" (printf "%s %d" $b.n $c) "params" $params) }}
  {{ end }}
{{ end }}
